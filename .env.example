# ═══════════════════════════════════════
#  Telegram
# ═══════════════════════════════════════
BOT_TOKEN=123456:ABC-DEF...
ADMIN_IDS=123456789

# ═══════════════════════════════════════
#  BuffPin API
# ═══════════════════════════════════════
BUFFPIN_HOST=https://api.buffpin.com
BUFFPIN_CLIENT_ID=tu_client_id
BUFFPIN_CLIENT_SECRET=tu_secret

# ═══════════════════════════════════════
#  OxaPay
# ═══════════════════════════════════════
OXAPAY_MERCHANT_KEY=tu_merchant_key
OXAPAY_PAYOUT_API_KEY=tu_payout_api_key
OXAPAY_GENERAL_API_KEY=tu_general_api_key
OXAPAY_SANDBOX=false

# ═══════════════════════════════════════
#  Servidor webhooks (tu dominio)
# ═══════════════════════════════════════
WEBHOOK_HOST=https://tudominio.com
WEBHOOK_PORT=8443

# ═══════════════════════════════════════
#  Valores iniciales (se guardan en DB, después los cambias desde /admin)
# ═══════════════════════════════════════
RETAIL_MARKUP_PERCENT=20
RESELLER_MARKUP_PERCENT=8
MIN_DEPOSIT_USD=5
MIN_WITHDRAWAL=10
REFERRAL_COMMISSION_PCT=5
DB_PATH=gamestore.db
